FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# restore first so docker can cache it
COPY app/backend/HelpDeskHQ/HelpDeskHQ.Api/HelpDeskHQ.Api.csproj HelpDeskHQ.Api/
RUN dotnet restore HelpDeskHQ.Api/HelpDeskHQ.Api.csproj

COPY app/backend/HelpDeskHQ/HelpDeskHQ.Api/ HelpDeskHQ.Api/
RUN dotnet publish HelpDeskHQ.Api/HelpDeskHQ.Api.csproj -c Release -o /out --no-restore

FROM build AS migrations
RUN dotnet tool install --global dotnet-ef --version 10.0.12
ENV PATH="$PATH:/root/.dotnet/tools"
# fake values, the app will not start without them
RUN ConnectionStrings__DefaultConnection="Host=none" Jwt__Key="fake-key-only-for-building-the-bundle" \
    dotnet ef migrations bundle --project HelpDeskHQ.Api/HelpDeskHQ.Api.csproj --self-contained -r linux-x64 -o /out/efbundle

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS migrate
WORKDIR /app
COPY --from=migrations /out/efbundle .
USER app
ENTRYPOINT ["./efbundle"]

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .

USER app

EXPOSE 8080
ENTRYPOINT ["dotnet", "HelpDeskHQ.Api.dll"]